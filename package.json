{
  "name": "bee-guard-digital-twin",
  "private": true,
  "version": "0.8.0-rc1",
  "description": "BEE-GUARD Mission Control — interactive 3D research simulation with simulated sensing, comms, survey coverage, corridor validation and evacuation planning (simulated data only, not a validated physical digital twin).",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "experiments": "tsx experiments/run.ts",
    "experiments:factors": "tsx experiments/run_factors.ts",
    "assets:scan": "tsx scripts/scan-assets.ts",
    "check:offline": "tsx scripts/check-offline.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "tsx": "^4.19.0"
  }
}
